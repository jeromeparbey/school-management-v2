// prisma/tenant-template.prisma
// TEMPLATE - Utilisé pour générer dynamiquement le schéma de chaque tenant
// La variable ${SCHEMA_NAME} est remplacée à la volée

generator client {
  provider = "prisma-client-js"
  output   = "../../prisma/generated/tenants/${SCHEMA_NAME}-client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["${SCHEMA_NAME}"]
}

// ══════════════════════════════════════════════════════════
// À PARTIR D'ICI : TOUTES LES TABLES MÉTIER DU TENANT
// (utilisateurs, élèves, notes, paiements, etc.)
// ══════════════════════════════════════════════════════════

// ============ UTILISATEURS LOCAUX AU TENANT ============

model Utilisateur {
  id                 String          @id @default(cuid())
  email              String          @unique
  motDePasse         String
  prenom             String
  nom                String
  role               RoleUtilisateur @default(ENSEIGNANT)
  estActif           Boolean         @default(true)
  emailVerifie       Boolean         @default(false)
  telephone          String?
  photoProfil        String?
  derniereConnexion  DateTime?
  jetonActualisation String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Profils métier
  eleve              Eleve?
  enseignant         Enseignant?
  surveillant        Surveillant?
  parent             Parent?
  admin              Admin?
  directeur          Directeur?

  // Créations / Modifications
  elevesCrees        Eleve[]         @relation("EleveCreateur")
  elevesModifies     Eleve[]         @relation("EleveModificateur")
  enseignantsCrees   Enseignant[]    @relation("EnseignantCreateur")
  enseignantsModifies Enseignant[]   @relation("EnseignantModificateur")

  // Paiements
  paiementsCrees     Paiement[]      @relation("PaiementCreateur")
  paiementsAnnules   Paiement[]      @relation("PaiementAnnuleur")

  // Approbations
  absencesApprouvees Absence[]       @relation("AbsenceApprobateur")
  avancesApprouvees  Avance[]        @relation("AvanceApprobateur")
  heuresSuppApprouvees HeureSupp[]   @relation("HeureSuppApprobateur")
  reclamationsAssignees Reclamation[] @relation("ReclamationAssignee")
  reductionsApprouvees Reduction[]   @relation("ReductionApprobateur")
  bulletinsValides   Bulletin[]      @relation("BulletinValidateur")
  paiesApprouvees    Paie[]          @relation("PaieApprobateur")
  historiquesSalairesApprouves HistoriqueSalaire[] @relation("HistoriqueSalaireApprobateur")

  // Bulletins et notes
  bulletinsGenres    Bulletin[]      @relation("BulletinGenerateur")
  notesSaisies       Note[]          @relation("NoteSaisisseur")
  notesModifiees     Note[]          @relation("NoteModificateur")
  notesValidees      Note[]          @relation("NoteValidateur")
  appreciations      Appreciation[]  @relation("AppreciationAuteur")

  // Emplois du temps
  emploisTempsCrees  EmploiTemps[]   @relation("EmploiTempsCreateur")

  // Reçus
  recusGeneres       Recu[]          @relation("RecuGenerateur")

  // Messagerie
  messagesEnvoyes    Message[]       @relation("MessageExpediteur")
  messagesRecus      MessageDestinataire[]
  messagesReponses   MessageReponse[]
  communiquesCrees   Communique[]    @relation("CommuniqueCreateur")
  communiquesVus     CommuniqueVu[]

  // Chat
  conversations      ConversationParticipant[]
  messagesChat       ChatMessage[]   @relation("ChatMessageExpediteur")

  // Documents
  documentsCrees     Document[]      @relation("DocumentCreateur")

  // Objectifs
  objectifsAssignes  Objectif[]      @relation("ObjectifAssigneur")
  objectifsSuivis    ObjectifSuivi[]

  // Groupes TD
  groupesTDCrees     GroupeTD[]      @relation("GroupeTDCreateur")
  membresGroupesTD   MembreGroupeTD[]

  // Surveillance et incidents
  surveillancesGerees Surveillance[] @relation("SurveillanceUtilisateur")
  incidentsSignales  Incident[]      @relation("IncidentSignaleur")
  incidentsTraites   Incident[]      @relation("IncidentTraiteur")

  // Bibliothèque
  empruntsBibliotheque EmpruntLivre[] @relation("EmpruntEmprunteur")
  empruntsGeres      EmpruntLivre[]  @relation("EmpruntGestionnaire")

  // Logs
  logsAudit          LogAudit[]
  notifications      Notification[]
  logsEmail          LogEmail[]

  // Communication
  communicationsEnvoyees Communication[] @relation("CommunicationExpediteur")
  communicationsRecues   Communication[] @relation("CommunicationDestinataire")

  @@index([role])
  @@map("utilisateurs")
}

enum RoleUtilisateur {
  DIRECTEUR
  SECRETAIRE
  ENSEIGNANT
  SURVEILLANT
  PARENT
  ELEVE
  ADMIN
  BIBLIOTHECAIRE
}

// ============ PARAMETRES DU TENANT ============

model ParametreTenant {
  id              String        @id @default(cuid())
  cle             String        @unique
  valeur          Json
  categorie       String        @default("GENERAL")
  description     String?
  type            TypeParametre @default(STRING)
  estSysteme      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([categorie])
  @@map("parametres")
}

enum TypeParametre {
  STRING
  NUMBER
  BOOLEAN
  JSON
  ARRAY
  DATE
}

// ============ ADMINISTRATEURS ET DIRECTEURS ============

model Admin {
  id              String        @id @default(cuid())
  utilisateurId   String        @unique
  niveau          NiveauAdmin   @default(ADMIN_ETABLISSEMENT)
  permissions     Json?
  estActif        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  utilisateur     Utilisateur   @relation(fields: [utilisateurId], references: [id])

  @@map("admins")
}

enum NiveauAdmin {
  ADMIN_SYSTEME
  ADMIN_ETABLISSEMENT
}

model Directeur {
  id              String        @id @default(cuid())
  utilisateurId   String        @unique
  dateNomination  DateTime?
  signature       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  utilisateur     Utilisateur   @relation(fields: [utilisateurId], references: [id])

  @@map("directeurs")
}

// ============ PARENTS ============

model Parent {
  id                  String        @id @default(cuid())
  utilisateurId       String        @unique
  profession          String?
  adresse             String?
  telephoneSecondaire String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  utilisateur         Utilisateur   @relation(fields: [utilisateurId], references: [id])
  enfants             ParentEleve[]
  conversations       ConversationParticipant[]
  messagesChat        ChatMessage[]

  @@map("parents")
}

model ParentEleve {
  id                  String   @id @default(cuid())
  parentId            String
  eleveId             String
  lien                String
  estPrincipal        Boolean  @default(false)
  peutRecupererEleve  Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  parent              Parent   @relation(fields: [parentId], references: [id])
  eleve               Eleve    @relation(fields: [eleveId], references: [id])

  @@unique([parentId, eleveId])
  @@map("parent_eleve")
}

// ============ SURVEILLANTS ============

model Surveillant {
  id               String        @id @default(cuid())
  utilisateurId    String        @unique
  matricule        String        @unique
  prenom           String
  nom              String
  sexe             String
  dateNaissance    DateTime?
  telephone        String
  email            String?
  adresse          String?
  photo            String?
  dateEmbauche     DateTime
  typeContrat      String
  zoneSurveillance String?
  estActif         Boolean       @default(true)
  estArchive       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  utilisateur      Utilisateur   @relation(fields: [utilisateurId], references: [id])
  surveillances    Surveillance[]
  incidents        Incident[]    @relation("IncidentSurveillant")
  presences        PresenceSurveillant[]

  @@map("surveillants")
}

// ============ ANNEE SCOLAIRE ET NIVEAUX ============

model AnneeScolaire {
  id          String   @id @default(cuid())
  nom         String
  dateDebut   DateTime
  dateFin     DateTime
  estActive   Boolean  @default(false)
  estArchive  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes         Classe[]
  inscriptions    Inscription[]
  plansScolarite  PlanScolarite[]
  periodes        Periode[]
  bulletins       Bulletin[]
  affectations    AffectationEnseignant[]
  assignments     AssignmentScolarite[]
  emploisTemps    EmploiTemps[]
  groupesTD       GroupeTD[]
  objectifs       Objectif[]

  @@map("annees_scolaires")
}

model Periode {
  id              String        @id @default(cuid())
  nom             String
  type            TypePeriode
  dateDebut       DateTime
  dateFin         DateTime
  ordre           Int
  anneeScolaireId String
  estActive       Boolean       @default(true)
  estCloturee     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  bulletins       Bulletin[]
  notes           Note[]
  appreciations   Appreciation[]
  objectifs       Objectif[]

  @@map("periodes")
}

enum TypePeriode {
  TRIMESTRE
  SEMESTRE
  BULLETIN
}

model Niveau {
  id               String            @id @default(cuid())
  nom              String
  code             String            @unique
  description      String?
  ordre            Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  classes          Classe[]
  matieres         Matiere[]
  plansScolarite   PlanScolarite[]
  reglesEvaluation RegleEvaluation[]

  @@map("niveaux")
}

// ============ CLASSES ET MATIERES ============

model Classe {
  id              String        @id @default(cuid())
  nom             String
  code            String        @unique
  capacite        Int?
  salle           String?
  anneeScolaireId String
  niveauId        String
  estActive       Boolean       @default(true)
  estArchive      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  niveau          Niveau        @relation(fields: [niveauId], references: [id])
  inscriptions    Inscription[]
  affectations    AffectationEnseignant[]
  emploisTemps    EmploiTemps[]
  plansScolarite  PlanScolarite[]
  bulletins       Bulletin[]
  assignments     AssignmentScolarite[]
  groupesTD       GroupeTD[]
  objectifs       Objectif[]

  @@map("classes")
}

model Matiere {
  id               String            @id @default(cuid())
  nom              String
  code             String            @unique
  niveauId         String
  coefficient      Float             @default(1.0)
  dureeCours       Int               @default(60)
  description      String?
  estActive        Boolean           @default(true)
  estArchive       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  niveau           Niveau            @relation(fields: [niveauId], references: [id])
  affectations     AffectationEnseignant[]
  emploisTemps     EmploiTemps[]
  notes            Note[]
  reglesEvaluation RegleEvaluation[]
  appreciations    Appreciation[]
  documents        Document[]
  groupesTD        GroupeTD[]

  @@map("matieres")
}

// ============ ELEVES ============

model Eleve {
  id            String      @id @default(cuid())
  matricule     String      @unique
  prenom        String
  nom           String
  sexe          String
  dateNaissance DateTime
  lieuNaissance String?
  nationalite   String?
  adresse       String?
  telephone     String?
  email         String?
  photo         String?
  infoMedicale  String?
  groupeSanguin String?
  allergies     String?
  statut        StatutEleve @default(ACTIF)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  utilisateurId String?     @unique
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id])

  creeParId     String?
  creePar       Utilisateur? @relation("EleveCreateur", fields: [creeParId], references: [id])
  modifieParId  String?
  modifiePar    Utilisateur? @relation("EleveModificateur", fields: [modifieParId], references: [id])

  inscriptions        Inscription[]
  responsables        Responsable[]
  assignmentsScolarite AssignmentScolarite[]
  paiements    Paiement[]
  reductions   Reduction[]
  recus        Recu[]
  notes        Note[]
  bulletins    Bulletin[]
  appreciations Appreciation[]
  parents      ParentEleve[]
  presences    PresenceEleve[]
  absences     AbsenceEleve[]
  communications Communication[] @relation("CommunicationEleve")
  conversations  ConversationParticipant[]
  messagesChat   ChatMessage[] @relation("ChatMessageEleve")
  objectifs       Objectif[]
  objectifsSuivis ObjectifSuivi[]
  membresGroupesTD MembreGroupeTD[]
  incidents Incident[] @relation("IncidentEleve")
  empruntsLivres EmpruntLivre[]

  @@index([statut])
  @@index([nom, prenom])
  @@map("eleves")
}

enum StatutEleve {
  ACTIF
  TRANSFERE
  SORTI
  SUSPENDU
  ARCHIVE
}

model Responsable {
  id           String   @id @default(cuid())
  prenom       String
  nom          String
  lien         String
  telephone    String
  email        String?
  adresse      String?
  profession   String?
  estPrincipal Boolean  @default(false)
  eleveId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  eleve        Eleve    @relation(fields: [eleveId], references: [id])

  @@map("responsables")
}

model Inscription {
  id              String        @id @default(cuid())
  eleveId         String
  classeId        String
  anneeScolaireId String
  dateInscription DateTime      @default(now())
  estActive       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  eleve           Eleve         @relation(fields: [eleveId], references: [id])
  classe          Classe        @relation(fields: [classeId], references: [id])
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])

  @@unique([eleveId, classeId, anneeScolaireId])
  @@map("inscriptions")
}

// ============ ENSEIGNANTS ============

model Enseignant {
  id             String   @id @default(cuid())
  matricule      String   @unique
  prenom         String
  nom            String
  sexe           String
  dateNaissance  DateTime
  telephone      String
  email          String?  @unique
  adresse        String?
  photo          String?
  dateEmbauche   DateTime
  typeContrat    String
  qualification  String?
  specialite     String?
  salaireBase    Float
  infosBancaires Json?
  estActif       Boolean  @default(true)
  estArchive     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  utilisateurId String?      @unique
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id])

  creeParId    String?
  creePar      Utilisateur? @relation("EnseignantCreateur", fields: [creeParId], references: [id])
  modifieParId String?
  modifiePar   Utilisateur? @relation("EnseignantModificateur", fields: [modifieParId], references: [id])

  affectations AffectationEnseignant[]
  emploisTemps EmploiTemps[]
  notes        Note[]                @relation("NoteEnseignant")
  documents    Document[]
  groupesTD    GroupeTD[]
  communications Communication[]     @relation("CommunicationEnseignant")
  conversations  ConversationParticipant[]
  messagesChat   ChatMessage[]       @relation("ChatMessageEnseignant")
  objectifsAssignes Objectif[]       @relation("ObjectifEnseignant")
  presences         Presence[]
  heuresSupp        HeureSupp[]
  absences          Absence[]
  avances           Avance[]
  reclamations      Reclamation[]
  paies             Paie[]
  historiquesSalaire HistoriqueSalaire[]

  @@index([estActif])
  @@index([nom, prenom])
  @@map("enseignants")
}

model AffectationEnseignant {
  id              String        @id @default(cuid())
  enseignantId    String
  classeId        String
  matiereId       String
  anneeScolaireId String
  heuresHebdo     Float?        @default(0)
  estPrincipal    Boolean       @default(false)
  valableDu       DateTime
  valableAu       DateTime?
  estActive       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  enseignant      Enseignant    @relation(fields: [enseignantId], references: [id])
  classe          Classe        @relation(fields: [classeId], references: [id])
  matiere         Matiere       @relation(fields: [matiereId], references: [id])
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])

  @@unique([enseignantId, classeId, matiereId, anneeScolaireId])
  @@map("affectations_enseignants")
}

// ============ EMPLOI DU TEMPS ============

model EmploiTemps {
  id              String        @id @default(cuid())
  jour            JourSemaine
  heureDebut      String
  heureFin        String
  classeId        String
  enseignantId    String
  matiereId       String
  salle           String?
  estRecurrent    Boolean       @default(true)
  valableDu       DateTime
  valableAu       DateTime?
  estActive       Boolean       @default(true)
  creePar         String
  anneeScolaireId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  classe          Classe        @relation(fields: [classeId], references: [id])
  enseignant      Enseignant    @relation(fields: [enseignantId], references: [id])
  matiere         Matiere       @relation(fields: [matiereId], references: [id])
  creeParUtilisateur Utilisateur @relation("EmploiTempsCreateur", fields: [creePar], references: [id])
  anneeScolaire   AnneeScolaire? @relation(fields: [anneeScolaireId], references: [id])

  @@map("emplois_temps")
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

// ============ PRESENCE ENSEIGNANTS ============

model Presence {
  id           String         @id @default(cuid())
  enseignantId String
  heureArrivee DateTime?
  heureDepart  DateTime?
  date         DateTime       @default(now())
  statut       StatutPresence @default(PRESENT)
  notes        String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  enseignant   Enseignant     @relation(fields: [enseignantId], references: [id])

  @@unique([enseignantId, date])
  @@map("presences")
}

enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
  EXCUSE
  CONGE
  FORMATION
}

model PresenceSurveillant {
  id            String         @id @default(cuid())
  surveillantId String
  heureArrivee  DateTime?
  heureDepart   DateTime?
  date          DateTime       @default(now())
  statut        StatutPresence @default(PRESENT)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  surveillant   Surveillant    @relation(fields: [surveillantId], references: [id])

  @@unique([surveillantId, date])
  @@map("presences_surveillants")
}

model HeureSupp {
  id           String        @id @default(cuid())
  enseignantId String
  date         DateTime
  heureDebut   String?
  heureFin     String?
  heures       Float
  motif        String?
  statut       StatutDemande @default(BROUILLON)
  approuvePar  String?
  approuveLe   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  enseignant   Enseignant    @relation(fields: [enseignantId], references: [id])
  approbateur  Utilisateur?  @relation("HeureSuppApprobateur", fields: [approuvePar], references: [id])

  @@map("heures_supp")
}

// ============ PRESENCE ET ABSENCE ELEVES ============

model PresenceEleve {
  id               String               @id @default(cuid())
  eleveId          String
  classeId         String
  date             DateTime             @default(now())
  heureArrivee     DateTime?
  statut           StatutPresenceEleve  @default(PRESENT)
  motif            String?
  justificatif     String?
  justificatifType String?
  notes            String?
  enregistrePar    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  eleve            Eleve                @relation(fields: [eleveId], references: [id])

  @@unique([eleveId, date])
  @@index([classeId, date])
  @@map("presences_eleves")
}

enum StatutPresenceEleve {
  PRESENT
  ABSENT
  RETARD
  EXCUSE
  SORTIE_ANTICIPEE
}

model AbsenceEleve {
  id               String           @id @default(cuid())
  eleveId          String
  dateDebut        DateTime
  dateFin          DateTime
  type             TypeAbsenceEleve
  motif            String
  justificatif     String?
  justificatifType String?
  statut           StatutDemande    @default(BROUILLON)
  approuvePar      String?
  approuveLe       DateTime?
  motifRejet       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  eleve            Eleve            @relation(fields: [eleveId], references: [id])

  @@map("absences_eleves")
}

enum TypeAbsenceEleve {
  MALADIE
  RAISON_FAMILIALE
  VOYAGE
  DISPENSE
  AUTRE
}

// ============ ABSENCES, AVANCES, RECLAMATIONS ============

model Absence {
  id           String        @id @default(cuid())
  enseignantId String
  type         TypeAbsence
  dateDebut    DateTime
  dateFin      DateTime
  motif        String
  pieceJointe  String?
  statut       StatutDemande @default(BROUILLON)
  approuvePar  String?
  approuveLe   DateTime?
  motifRejet   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  enseignant   Enseignant    @relation(fields: [enseignantId], references: [id])
  approbateur  Utilisateur?  @relation("AbsenceApprobateur", fields: [approuvePar], references: [id])

  @@map("absences")
}

enum TypeAbsence {
  CONGES_ANNUELS
  MALADIE
  MATERNITE
  PATERNITE
  PERSONNELLE
  NON_PAYEE
  FORMATION
}

enum StatutDemande {
  BROUILLON
  SOUMISE
  APPROUVEE
  REJETEE
  ANNULEE
}

model Avance {
  id                 String        @id @default(cuid())
  enseignantId       String
  montant            Float
  motif              String
  dateDemandee       DateTime
  remboursementPrevu String?
  statut             StatutDemande @default(BROUILLON)
  approuvePar        String?
  approuveLe         DateTime?
  motifRejet         String?
  integreePaie       Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  enseignant         Enseignant    @relation(fields: [enseignantId], references: [id])
  approbateur        Utilisateur?  @relation("AvanceApprobateur", fields: [approuvePar], references: [id])

  @@map("avances")
}

model Reclamation {
  id                 String            @id @default(cuid())
  enseignantId       String
  categorie          String
  sujet              String
  description        String
  piecesJointes      String[]
  priorite           Priorite          @default(MOYENNE)
  statut             StatutReclamation @default(OUVERTE)
  assigneA           String?
  reponse            String?
  fermeeLe           DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  enseignant         Enseignant        @relation(fields: [enseignantId], references: [id])
  assigneUtilisateur Utilisateur?      @relation("ReclamationAssignee", fields: [assigneA], references: [id])

  @@map("reclamations")
}

enum Priorite {
  BASSE
  MOYENNE
  HAUTE
  CRITIQUE
}

enum StatutReclamation {
  OUVERTE
  EN_COURS
  RESOLUE
  FERMEE
}

// ============ SCOLARITE ET PAIEMENTS ============

model PlanScolarite {
  id               String          @id @default(cuid())
  nom              String
  description      String?
  anneeScolaireId  String
  niveauId         String?
  classeId         String?
  fraisInscription Float           @default(0)
  fraisScolarite   Float           @default(0)
  autresFrais      Json?
  montantTotal     Float
  devise           String          @default("XOF")
  estActif         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  anneeScolaire    AnneeScolaire   @relation(fields: [anneeScolaireId], references: [id])
