}

model MembreGroupeTD {
  id            String         @id @default(cuid())
  groupeTDId    String
  eleveId       String
  utilisateurId String?
  dateAdhesion  DateTime       @default(now())
  statut        StatutMembreTD @default(ACTIF)
  montantPaye   Float          @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  groupeTD      GroupeTD       @relation(fields: [groupeTDId], references: [id])
  eleve         Eleve          @relation(fields: [eleveId], references: [id])
  utilisateur   Utilisateur?   @relation(fields: [utilisateurId], references: [id])

  @@unique([groupeTDId, eleveId])
  @@map("membres_groupe_td")
}

model PaiementGroupeTD {
  id            String        @id @default(cuid())
  groupeTDId    String
  eleveId       String
  montant       Float
  mois          String?
  datePaiement  DateTime      @default(now())
  moyenPaiement MoyenPaiement
  reference     String?
  statut        StatutPaiement @default(COMPLET)
  createdAt     DateTime      @default(now())

  groupeTD      GroupeTD      @relation(fields: [groupeTDId], references: [id])

  @@map("paiements_groupe_td")
}

model SeanceTD {
  id              String   @id @default(cuid())
  groupeTDId      String
  date            DateTime
  heureDebut      String
  heureFin        String
  salle           String?
  theme           String?
  description     String?
  estAnnulee      Boolean  @default(false)
  motifAnnulation String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  groupeTD        GroupeTD @relation(fields: [groupeTDId], references: [id])

  @@map("seances_td")
}

enum StatutMembreTD {
  ACTIF
  INACTIF
  SUSPENDU
  TERMINE
}

// ============ BIBLIOTHEQUE ============

model CategorieLivre {
  id          String   @id @default(cuid())
  nom         String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  livres      Livre[]

  @@map("categories_livres")
}

model Livre {
  id                     String         @id @default(cuid())
  categorieId            String?
  isbn                   String?
  titre                  String
  auteur                 String
  editeur                String?
  anneeEdition           Int?
  langue                 String         @default("Français")
  description            String?
  couverture             String?
  nombreExemplaires      Int            @default(1)
  exemplairesDisponibles Int            @default(1)
  emplacement            String?
  cote                   String?
  estActif               Boolean        @default(true)
  estArchive             Boolean        @default(false)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  categorie              CategorieLivre? @relation(fields: [categorieId], references: [id])
  emprunts               EmpruntLivre[]

  @@index([titre])
  @@index([isbn])
  @@map("livres")
}

model EmpruntLivre {
  id               String         @id @default(cuid())
  livreId          String
  eleveId          String?
  utilisateurId    String?
  dateEmprunt      DateTime       @default(now())
  dateRetourPrevue DateTime
  dateRetourReelle DateTime?
  statut           StatutEmprunt  @default(EN_COURS)
  penalite         Float          @default(0)
  penalitePayee    Boolean        @default(false)
  notes            String?
  gerePar          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  livre            Livre          @relation(fields: [livreId], references: [id])
  eleve            Eleve?         @relation(fields: [eleveId], references: [id])
  emprunteur       Utilisateur?   @relation("EmpruntEmprunteur", fields: [utilisateurId], references: [id])
  gestionnaire     Utilisateur?   @relation("EmpruntGestionnaire", fields: [gerePar], references: [id])

  @@index([livreId])
  @@index([eleveId])
  @@index([statut])
  @@map("emprunts_livres")
}

enum StatutEmprunt {
  EN_COURS
  RETOURNE
  EN_RETARD
  PERDU
  ENDOMMAGE
}

// ============ SURVEILLANCE ET INCIDENTS ============

model Surveillance {
  id            String           @id @default(cuid())
  surveillantId String
  utilisateurId String
  zone          String
  date          DateTime
  heureDebut    String
  heureFin      String
  type          TypeSurveillance @default(COUR)
  description   String?
  estTerminee   Boolean          @default(false)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  surveillant   Surveillant      @relation(fields: [surveillantId], references: [id])
  utilisateur   Utilisateur      @relation("SurveillanceUtilisateur", fields: [utilisateurId], references: [id])
  incidents     Incident[]

  @@index([surveillantId, date])
  @@map("surveillances")
}

model Incident {
  id              String          @id @default(cuid())
  surveillantId   String?
  signalePar      String
  traitePar       String?
  eleveId         String?
  surveillanceId  String?
  type            TypeIncident
  gravite         GraviteIncident @default(MINEUR)
  titre           String
  description     String
  lieu            String?
  dateIncident    DateTime
  pieceJointe     String?
  pieceJointeType String?
  statut          StatutIncident  @default(OUVERT)
  resolution      String?
  dateResolution  DateTime?
  sanction        String?
  parentsNotifies Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  surveillant     Surveillant?    @relation("IncidentSurveillant", fields: [surveillantId], references: [id])
  signaleur       Utilisateur     @relation("IncidentSignaleur", fields: [signalePar], references: [id])
  traiteur        Utilisateur?    @relation("IncidentTraiteur", fields: [traitePar], references: [id])
  eleve           Eleve?          @relation("IncidentEleve", fields: [eleveId], references: [id])
  surveillance    Surveillance?   @relation(fields: [surveillanceId], references: [id])

  @@index([statut])
  @@index([eleveId])
  @@map("incidents")
}

enum TypeSurveillance {
  COUR
  RECREATION
  CANTINE
  ENTREE
  SORTIE
  EXAMEN
  ACTIVITE
  NUIT
}

enum TypeIncident {
  DISPUTE
  VIOLENCE
  TRICHERIE
  RETARD_REPETE
  ABSENCE_INJUSTIFIEE
  DEGRADATION
  VOL
  INSUBORDINATION
  HARCELEMENT
  AUTRE
}

enum GraviteIncident {
  MINEUR
  MODERE
  GRAVE
  TRES_GRAVE
}

enum StatutIncident {
  OUVERT
  EN_COURS
  RESOLU
  FERME
  ESCALADE
}

// ============ COMMUNICATION ECOLE ============

model Communication {
  id              String        @id @default(cuid())
  eleveId         String?
  enseignantId    String?
  expediteurId    String
  destinataireId  String
  sujet           String
  contenu         String
  type            String        @default("NORMAL")
  lu              Boolean       @default(false)
  luLe            DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  eleve           Eleve?        @relation("CommunicationEleve", fields: [eleveId], references: [id])
  enseignant      Enseignant?   @relation("CommunicationEnseignant", fields: [enseignantId], references: [id])
  expediteur      Utilisateur   @relation("CommunicationExpediteur", fields: [expediteurId], references: [id])
  destinataire    Utilisateur   @relation("CommunicationDestinataire", fields: [destinataireId], references: [id])

  @@index([destinataireId, lu])
  @@index([expediteurId])
  @@map("communications")
}